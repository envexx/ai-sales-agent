# ─────────────────────────────────────────────────────────────
#  Sales Automation — Environment
#  Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# Port API backend. Sengaja di luar 3000/3001 agar tidak bentrok sistem lain.
PORT=4000
LOG_LEVEL=info

# ── LLM: DeepSeek (OpenAI-compatible Chat Completions) ───────
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model used for all reasoning nodes (structured output capable).
DEEPSEEK_MODEL=deepseek-chat
# Optional: stronger model for evaluation/reflection (plain JSON, no tools).
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
# Set to "true" to use the reasoning model for evaluation/reflection.
USE_REASONING_MODEL=false

# ── LLM provider selection ───────────────────────────────────
# Provider default: deepseek | antigravity | openrouter.
LLM_PROVIDER=deepseek
# Override per-node berdasarkan `name`, mis.:
#   SupervisorRoute=antigravity,ResearchPlan=antigravity,ResearchVerify=antigravity
LLM_PROVIDER_OVERRIDES=
# Bila provider utama gagal, otomatis kembali ke DeepSeek (cara lama).
LLM_FALLBACK_TO_DEEPSEEK=true
# Rantai fallback berlapis (urut, dipisah koma), mis. "openrouter" atau
# "openrouter,deepseek". Provider dicoba berurutan sampai berhasil.
LLM_FALLBACK_PROVIDERS=openrouter,deepseek

# ── Antigravity CLI (provider alternatif) ────────────────────
# Install: irm https://antigravity.google/cli/install.ps1 | iex   (Windows)
# lalu login sekali: `agy`, dan cek `agy models`.
ANTIGRAVITY_ENABLED=true
ANTIGRAVITY_BIN=agy
ANTIGRAVITY_MODEL=
ANTIGRAVITY_EFFORT=medium
ANTIGRAVITY_TIMEOUT_MS=180000

# ── OpenRouter (provider OpenAI-compatible, bisa gratis) ─────
# Key dari https://openrouter.ai/keys (format: sk-or-v1-...).
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default: model gratis yang kuat. Lihat https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Header rekomendasi OpenRouter (opsional).
OPENROUTER_REFERER=https://localhost
OPENROUTER_TITLE=Sales Automation Agent

# ── Database: Postgres + pgvector ────────────────────────────
DATABASE_URL=postgres://sales:sales@localhost:5432/sales
# Optional: schema used by the LangGraph checkpointer (defaults to public).
CHECKPOINT_SCHEMA=public

# ── Embeddings ───────────────────────────────────────────────
# hash   -> zero-dependency deterministic embeddings (default, offline)
# local  -> @huggingface/transformers local model (needs the optional dep)
# openai -> any OpenAI-compatible /embeddings endpoint
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ── WhatsApp transport ───────────────────────────────────────
# console -> prints messages instead of sending (safe for development)
# baileys -> real WhatsApp connection via the Baileys library
WA_TRANSPORT=console
WA_AUTH_DIR=./baileys_auth
# Sambungkan WhatsApp otomatis saat boot (ketika WA_TRANSPORT=baileys).
WA_AUTO_CONNECT=true
# Kode negara default untuk normalisasi nomor lead (mis. 0812… → 62812…).
WA_DEFAULT_COUNTRY_CODE=62

# Membuat agen terlihat manusiawi: tampilkan "sedang menulis…" dan atur jeda
# kirim sesuai panjang pesan (karakter per detik + jitter).
WA_TYPING_ENABLED=true
WA_TYPING_CPS=11           # kecepatan mengetik (karakter/detik)
WA_TYPING_MIN_MS=1200      # jeda minimum
WA_TYPING_MAX_MS=12000     # jeda maksimum
WA_READ_RECEIPTS=true      # tandai pesan masuk sudah dibaca (centang biru)

# Keandalan kirim: tunggu koneksi sebentar lalu coba ulang bila gagal.
WA_SEND_CONNECT_TIMEOUT_MS=20000
WA_SEND_RETRIES=3
WA_SEND_RETRY_MS=3000

# ── Media masuk: voice note → Whisper, gambar → DeepSeek vision ──
# Diproses hanya saat pesannya berupa voice note / gambar (tidak selalu jalan).
MEDIA_ENABLED=true
WHISPER_ENABLED=true
# Python yang punya paket `faster-whisper` (lihat scripts/whisper_transcribe.py).
WHISPER_PYTHON=python
# tiny | base | small | medium | large-v3 (diunduh saat pertama dipakai).
WHISPER_MODEL=small
WHISPER_LANGUAGE=id
WHISPER_TIMEOUT_MS=180000
# Kosong = pakai DEEPSEEK_MODEL (DeepSeek mendukung input gambar).
VISION_ENABLED=true
VISION_MODEL=

# Never send real WhatsApp messages while DRY_RUN=true.
DRY_RUN=true

# ── RAG / Memory / Scoring ───────────────────────────────────
RAG_TOP_K=5
LTM_TOP_K=3
# 0 = the reflection loop runs once per conversation turn (no extra hop).
# >0 = allow the graph to re-enter RAG to self-improve after reflection.
MAX_REFLECTION_LOOPS=0
SCORE_THRESHOLD_LOW=40
SCORE_THRESHOLD_HIGH=75

# ── Supervisor Agent (orchestrator) ──────────────────────────
# Supervisor memilih agent mana yang menangani tiap pesan masuk.
# Selama baru ada satu agent, routing memakai heuristik + default (tanpa LLM).
# Set "true" untuk memaksa supervisor memakai LLM bahkan saat agent masih satu.
SUPERVISOR_FORCE_LLM=false

# ── Outbound prospecting (lead dari luar) ────────────────────
# Nadia hanya menghubungi prospek pada jam kerja berikut.
OUTREACH_ENABLED=true
WORK_START_HOUR=8          # 08:00
WORK_END_HOUR=17           # 17:00 (08.00–17.00)
WORK_DAYS=1,2,3,4,5        # Senin–Jumat (ISO: 1=Senin … 7=Minggu)
WORK_TIMEZONE=Asia/Jakarta
OUTREACH_TICK_SECONDS=60   # seberapa sering penjadwal bangun
OUTREACH_BATCH=3           # maksimal prospek per tick
OUTREACH_MAX_ATTEMPTS=2    # 1 pesan pembuka + 1 follow-up
OUTREACH_DELAY_MS=20000    # jeda antar pesan dalam satu tick
OUTREACH_FOLLOWUP_HOURS=48 # jeda sebelum follow-up

# ── Business context (used by the prompts) ───────────────────
BUSINESS_NAME=PT Core Solution Digital
BUSINESS_DESCRIPTION=Perusahaan pengembangan solusi digital: custom web application, AI business automation, custom AI agent, AI sales & lead automation, serta integrasi sistem dan internal business tools.
SALES_REP_NAME=Nadia
# Ganti dengan link Cal.com asli (dokumen KB masih memakai placeholder CAL_BOOKING_URL).
BOOKING_LINK=https://cal.com/your-booking-link

# ── API security (optional) ──────────────────────────────────
# If set, requests to /webhook/whatsapp must send `x-api-key: <value>`.
API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins, or "*" for all (development).
# The dashboard runs on http://localhost:3001 by default.
CORS_ORIGIN=*

# ── Cal.com MCP (scheduling) ─────────────────────────────────
# Isi API key Cal.com (cal_live_...) agar Nadia bisa cek jadwal kosong dan
# membuat booking lewat MCP server @calcom/cal-mcp. Kosongkan = nonaktif.
CAL_API_KEY=
# Alternatif: hosted MCP server (OAuth), https://mcp.cal.com/mcp
CAL_MCP_URL=
# Ekspos seluruh tool Cal.com (dibutuhkan untuk getAvailableSlots).
CAL_MCP_ALL_TOOLS=true
# Opsional: paksa satu event type (lihat daftarnya: npm run cal:tools)
CAL_EVENT_TYPE_ID=
CAL_TIMEZONE=Asia/Jakarta
# Berapa hari ke depan ketersediaan dicari.
CAL_SLOT_DAYS=7

# ── Research Agent (Universal Research Engine) ───────────────
# Engine riset reusable: planner → ingestion → ekstraksi → evaluasi → formatter.
RESEARCH_ENABLED=true
# Folder workspace untuk laporan + evidence (file), metadata masuk Postgres.
RESEARCH_WORKSPACE_DIR=./workspace/research
RESEARCH_DEFAULT_DEPTH=2
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_SOURCES=12
RESEARCH_TIME_BUDGET_MS=240000
RESEARCH_PER_SOURCE_CHARS=8000
RESEARCH_MAX_FACTS=80
RESEARCH_CONCURRENCY=3
# Batas saat riset dipicu dari chat/WhatsApp (harus singkat).
RESEARCH_CHAT_ENABLED=true
RESEARCH_CHAT_MAX_ITERATIONS=1
RESEARCH_CHAT_MAX_SOURCES=5
RESEARCH_CHAT_TIME_BUDGET_MS=90000

# ── Firecrawl (ingestion engine #1) ──────────────────────────
# Self-hosted Firecrawl. Kosongkan FIRECRAWL_API_KEY bila tanpa auth.
FIRECRAWL_ENABLED=true
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
FIRECRAWL_API_KEY=
# Sumber discovery URL: auto | tavily | searxng | firecrawl | bing | camoufox | none.
# auto = Tavily (bila aktif) → SearXNG → Bing (Firecrawl) → Bing (Camoufox) → Firecrawl /v1/search.
RESEARCH_SEARCH_PROVIDER=auto
# Endpoint SearXNG (JSON API). Default menunjuk proxy `searxng-proxy`
# (docker compose) yang meneruskan ke SearXNG milik stack Firecrawl.
RESEARCH_SEARXNG_URL=http://127.0.0.1:8081

# ── Camoufox (ingestion engine #2, stealth browser) ──────────
# Install: `pip install camoufox` lalu `camoufox fetch`.
CAMOUFOX_ENABLED=true
CAMOUFOX_PYTHON=python
CAMOUFOX_TIMEOUT_MS=45000

# ── Tavily (search + extract untuk AI agent) ─────────────────
# Fungsi tambahan Prospecting & Research: discovery yang lebih andal +
# ekstraksi kontak dari situs resmi tanpa bergantung Firecrawl.
# Daftar key gratis: https://app.tavily.com  (format: tvly-...)
TAVILY_ENABLED=true
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# basic | advanced (advanced lebih dalam, lebih lambat/mahal).
TAVILY_SEARCH_DEPTH=basic
TAVILY_EXTRACT_DEPTH=basic
TAVILY_MAX_RESULTS=8
TAVILY_INCLUDE_RAW_CONTENT=false
# Whitelist/blacklist domain (dipisah koma). Kosong = tanpa batasan.
TAVILY_INCLUDE_DOMAINS=
TAVILY_EXCLUDE_DOMAINS=

# ── Business pipeline (F0 orchestrator) ──────────────────────
PIPELINE_ENABLED=true
PIPELINE_TICK_SECONDS=30
PIPELINE_BATCH=5
PIPELINE_MAX_ATTEMPTS=3

# Notifikasi & perintah owner (isi nomor WhatsApp Anda).
NOTIFY_ENABLED=true
OWNER_WA_JID=
OWNER_NAME=Owner

# Daily briefing
BRIEFING_ENABLED=true
BRIEFING_HOUR=8
BRIEFING_TIMEZONE=Asia/Jakarta

# Approval (human-in-the-loop)
APPROVAL_TTL_HOURS=72
APPROVAL_PREFIX=APV

# Vault kredensial (AES-256-GCM). Kosong = vault nonaktif.
APP_SECRET=

# ── Research Prospecting (D1) ────────────────────────────────
PROSPECTING_ENABLED=true
PROSPECTING_DEFAULT_LIMIT=8
PROSPECTING_ENRICH=true
PROSPECTING_WAIT_MS=6000
# Mode tepat sasaran: bila PROSPECTING_NICHE kosong, ambil N niche dari katalog
# "siap-AI/low-tech" (lihat src/prospecting/targeting.ts) + kecualikan bisnis teknologi.
PROSPECTING_TARGET_COUNT=3
PROSPECTING_EXCLUDE_TECH=true
# Target lead tersimpan per hari (job harian mengelilingi katalog niche sampai tercapai).
PROSPECTING_DAILY_TARGET=20
PROSPECTING_NICHES_PER_ROUND=3
PROSPECTING_MAX_ROUNDS=8
# Target + kuota harian (F0.3): hari-1 stok awal, selanjutnya lead berkualitas.
PROSPECTING_NICHE=
PROSPECTING_LOCATION=
PROSPECTING_DAY1_QUOTA=100
PROSPECTING_DAILY_QUOTA=5
PROSPECTING_HOUR=9
SCOUT_DAILY_QUOTA=15
SCOUT_HOUR=10

# ── Scoper & PRD Builder (F2) ────────────────────────────────
SCOPER_ENABLED=true
PROJECTS_WORKSPACE_DIR=./workspace/projects

# ── Legal & Finance (F2) ─────────────────────────────────────
LEGAL_ENABLED=true
LEGAL_DUE_DAYS=7

# ── F2–F5 agent toggles ──────────────────────────────────────
INTAKE_ENABLED=true
# F0.6: link intake aman (token + expiry).
INTAKE_LINK_TTL_HOURS=72
# Base URL publik untuk link intake (kosong = http://localhost:PORT).
PUBLIC_BASE_URL=
QA_ENABLED=true
SCRIBE_ENABLED=true
HANDOVER_ENABLED=true
SUPPORT_ENABLED=true
MONITOR_ENABLED=true
CONTENT_ENABLED=true

# ── D4 · Developer & Automation (engine: OpenCode) ───────────
DEVELOPER_ENABLED=true
DEVELOPER_WORKSPACE_DIR=./workspace/developer
# Binary CLI OpenCode (headless `opencode run`). Pastikan ada di PATH.
DEVELOPER_OPENCODE_BIN=opencode
# Model OpenCode (format provider/model). Kosong = default OpenCode.
# PENTING: model default OpenCode harus punya kredit; mis. deepseek/deepseek-chat.
DEVELOPER_OPENCODE_MODEL=
# Agent OpenCode (mis. build). Kosong = default.
DEVELOPER_OPENCODE_AGENT=
DEVELOPER_OPENCODE_TIMEOUT_MS=600000
# Audit berkala situs/repo terpasang (harian).
DEVELOPER_SWEEP_ENABLED=true
DEVELOPER_SWEEP_HOUR=11
DEVELOPER_MAX_PLAN_ITEMS=12
# Kredensial platform (opsional; fitur aktif bila diisi). GitHub memakai `gh` login.
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_DEPLOY_HOOK_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare R2 (S3-compatible): Access Key ID, Secret Access Key, endpoint S3, bucket.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Endpoint S3 API, format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
# Opsional: URL publik bucket (custom domain / r2.dev).
CLOUDFLARE_R2_PUBLIC_URL=
SUPABASE_ACCESS_TOKEN=
SEARCH_CONSOLE_SITE_URL=
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
PLAUSIBLE_API_TOKEN=
PLAUSIBLE_SITE_ID=
# Monitor
MONITOR_MEMORY_MB=1024
MONITOR_WEBHOOK_TIMEOUT_MS=5000

# ── L1 Support: kanal klien (Telegram) ───────────────────────
# Default MATI: sesuai alur FLOW, klien lewat Sales; L1 menjawab ke Sales lalu
# Sales meneruskan. Nyalakan hanya untuk kanal opsional staf.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=8385496538:AAHsQAcsaddQX9VNOlij1dYZnmLPW813l9g
# Chat ID owner: laporan Supervisor (briefing/alert) dikirim ke sini.
# Chat ID bisa dilihat via GET /telegram/chats setelah mengirim pesan ke bot.
TELEGRAM_OWNER_CHAT_ID=
