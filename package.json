{
  "name": "sales-automation-langgraph",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp sales automation agent built with LangGraph (TypeScript), DeepSeek and Postgres/pgvector.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/seed.ts",
    "sim": "tsx src/scripts/simulate.ts",
    "cal:tools": "tsx src/scripts/cal-tools.ts",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/mcp-adapters": "^2.0.0",
    "@langchain/openai": "^1.6.2",
    "@langchain/textsplitters": "^1.0.2",
    "baileys": "^6.7.24",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
